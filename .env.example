# Copy to .env and fill in. .env is gitignored — never commit a real key.
# This repo is shared with five other people.

GEMINI_API_KEY=

# Model ID verified against Google's live deprecations page on 2026-09-04.
#   gemini-1.5-pro / gemini-1.5-flash  — RETIRED Sept 2025, do not use
#   gemini-2.0-flash                   — deprecated, shutdown 2026-06-01 (past)
#   gemini-2.5-flash / gemini-2.5-pro  — live, no shutdown announced
#   gemini-3.5/3.6/3.7/3.8-flash       — live; 3.8-flash is newest stable
# Re-check https://ai.google.dev/gemini-api/docs/deprecations before each demo.
#
# NOTE: gemini-3.8-flash is a native reasoning-tier model, so Module 1's prompt
# ships WITHOUT the explicit "think step by step" CoT trigger, per the
# model-tier note in Architecture.md Stage 3. If you switch to a fast-tier
# model, put that trigger back — see prompts/module1_itinerary.js.
GEMINI_MODEL_ID=gemini-3.8-flash
